[
  {
    "id": "chrome",
    "name": "Google Chrome",
    "category": "Browser",
    "vendor": "Google",
    "executables": [
      "chrome.exe",
      "googleupdate.exe"
    ],
    "paths": [
      "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"
    ],
    "monitoring": {
      "include": [
        {
          "event": "ProcessCreate",
          "condition": "contains",
          "field": "CommandLine",
          "value": "--load-extension=",
          "technique": "T1176",
          "comment": "Detect unauthorized browser extension loading"
        },
        {
          "event": "ProcessCreate",
          "condition": "contains",
          "field": "CommandLine",
          "value": "--remote-debugging-port=",
          "technique": "T1185",
          "comment": "Detect remote browser debugging session hijack"
        }
      ],
      "exclude": [
        {
          "event": "ProcessCreate",
          "condition": "begin with",
          "field": "CommandLine",
          "value": "\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --type=",
          "comment": "Filter Chrome child renderer/utility noise"
        },
        {
          "event": "ProcessCreate",
          "condition": "begin with",
          "field": "CommandLine",
          "value": "\"C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe\" --type=",
          "comment": "Filter Chrome x86 child processes"
        }
      ]
    }
  },
